{
  "version": 2,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin/admin.css", "destination": "/admin/admin.css" },
    { "source": "/admin/admin.js", "destination": "/admin/admin.js" },
    { "source": "/admin/login", "destination": "/admin/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/admin/(dashboard|overview|destinations|videos|stories|messages|enquiries|visitors|social|website|settings|activity|gallery|contact-info)", "destination": "/admin/index.html" },
    { "source": "/video/(.*)", "destination": "/index.html" },
    { "source": "/videos/(.*)", "destination": "/index.html" },
    { "source": "/article/(.*)", "destination": "/index.html" },
    { "source": "/articles/(.*)", "destination": "/index.html" },
    { "source": "/story/(.*)", "destination": "/index.html" },
    { "source": "/stories/(.*)", "destination": "/index.html" },
    { "source": "/destination/(.*)", "destination": "/index.html" },
    { "source": "/destinations/(.*)", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/travel", "destination": "/index.html" },
    { "source": "/food", "destination": "/index.html" },
    { "source": "/vlogs", "destination": "/index.html" },
    { "source": "/gallery", "destination": "/index.html" },
    { "source": "/reels", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" }
  ]
}
