{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin/login", "destination": "/admin/index.html" },
    { "source": "/admin/login/", "destination": "/admin/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/(about|travel|food|vlogs|reels|gallery|articles|destinations|contact)", "destination": "/index.html" }
  ]
}
