{
  "version": 2,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/admin/login", "dest": "/admin/index.html" },
    { "src": "/admin/login/", "dest": "/admin/index.html" },
    { "src": "/admin", "dest": "/admin/index.html" },
    { "src": "/admin/(.*)", "dest": "/admin/index.html" },
    { "src": "/(about|travel|food|vlogs|reels|gallery|articles|destinations|contact)", "dest": "/index.html" }
  ]
}
