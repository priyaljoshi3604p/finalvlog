{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "admin/**",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.svg",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/admin/admin.css", "dest": "/admin/admin.css" },
    { "src": "/admin/admin.js", "dest": "/admin/admin.js" },
    { "src": "/admin/login", "dest": "/admin/index.html" },
    { "src": "/admin", "dest": "/admin/index.html" },
    { "src": "/admin/", "dest": "/admin/index.html" },
    { "src": "/admin/(dashboard|overview|destinations|videos|stories|messages|enquiries|visitors|social|website|settings|activity|gallery|contact-info)", "dest": "/admin/index.html" },
    { "src": "/video/(.*)", "dest": "/index.html" },
    { "src": "/videos/(.*)", "dest": "/index.html" },
    { "src": "/article/(.*)", "dest": "/index.html" },
    { "src": "/articles/(.*)", "dest": "/index.html" },
    { "src": "/story/(.*)", "dest": "/index.html" },
    { "src": "/stories/(.*)", "dest": "/index.html" },
    { "src": "/destination/(.*)", "dest": "/index.html" },
    { "src": "/destinations/(.*)", "dest": "/index.html" },
    { "src": "/about", "dest": "/index.html" },
    { "src": "/travel", "dest": "/index.html" },
    { "src": "/food", "dest": "/index.html" },
    { "src": "/vlogs", "dest": "/index.html" },
    { "src": "/gallery", "dest": "/index.html" },
    { "src": "/reels", "dest": "/index.html" },
    { "src": "/contact", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
