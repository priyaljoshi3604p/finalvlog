# Veyra Trails Environment Variables Example

# Server Configuration
PORT=3000
JWT_SECRET=veyra_trails_super_secret_jwt_key_2026

# Supabase Configuration (PostgreSQL Database & Storage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Email Notification Credentials (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
ADMIN_EMAIL=admin_notifications@example.com

# Google Stitch API Configuration
STITCH_API_KEY=your_stitch_api_key
STITCH_PROJECT_ID=your_stitch_project_id
